---
import { Image } from 'astro:assets';
import heroKitReal from '../assets/kit-completo-hero.png';
import kitOpenReal from '../assets/kit-aberto-semanas.png';
import plantCutReal from '../assets/kit-produto-planta.png';
import photoComplete from '../assets/DSC01850.jpg';
import photoHerbs from '../assets/DSC01858.jpg';
import photoBoxPlant from '../assets/DSC01840.jpg';
import photoUnboxHorizontal from '../assets/DSC01877.jpg';
import photoDetailBox from '../assets/DSC01870.jpg';
import testimonial1 from '../assets/testimonials/depoimento-1.webp';
import testimonial2 from '../assets/testimonials/depoimento-2.jpeg';
import testimonial3 from '../assets/testimonials/depoimento-3.webp';
import testimonial4 from '../assets/testimonials/depoimento-4.webp';
import testimonialTera from '../../Depoimento-tera.jpeg';
import Logo from '../components/Logo.astro';
import '../styles/global.css';

const checkoutUrl = 'https://loja.metodomalach.com.br/produtos/';

// Vídeos reais gravados em formato vertical (UGC / Reels)
const videoTestimonials = [
  {
    src: '/videos/depoimento-1.mp4',
    name: 'Relato em Vídeo',
    tag: 'Ansiedade e Mente Acelerada',
    caption: '“A cabeça finalmente parou de girar. Consegui ter noites de sono que há anos eu não tinha.”'
  },
  {
    src: '/videos/depoimento-2.mp4',
    name: 'Relato em Vídeo',
    tag: 'Disposição Diária',
    caption: '“Acordava já cansado e sem ânimo para nada. O protocolo me devolveu a vontade de viver o dia.”'
  },
  {
    src: '/videos/depoimento-3.mp4',
    name: 'Relato em Vídeo',
    tag: 'Calma e Presença',
    caption: '“Voltei a ter paciência com meus filhos e foco no trabalho, sem aquela agitação no peito.”'
  }
];

// Comparativo de Monoproduto (Estilo Ryze Superfoods)
const comparisonRows = [
  {
    criterion: 'Origem dos Ativos',
    malach: '100% parte nobre vegetal, selecionada à mão',
    others: 'Fórmulas sintéticas ou partes menos potentes da planta'
  },
  {
    criterion: 'Sensação no Dia a Dia',
    malach: 'Calma com clareza mental e energia limpa',
    others: 'Letargia, sonolência diurna ou efeito rebote'
  },
  {
    criterion: 'Risco de Dependência Química',
    malach: 'Zero. Protocolo vegetal equilibrado',
    others: 'Frequente risco de tolerância e dependência'
  },
  {
    criterion: 'Tempo de Cuidado e Preparo',
    malach: 'Quase 60 dias de maturação artesanal por lote',
    others: 'Processamento ultra-industrializado acelerado'
  },
  {
    criterion: 'Suporte Durante o Uso',
    malach: 'Guia físico dos 30 dias + suporte atencioso',
    others: 'Você recebe um pote e se vira sozinho'
  }
];

// Provas de WhatsApp complementares
const imageTestimonials = [
  testimonial1,
  testimonial2,
  testimonial3,
  testimonial4,
  testimonialTera
];

// Perguntas frequentes diretas e sem juridiquês
const faqs = [
  {
    q: 'O que é o Método Malach e para quem ele é indicado?',
    a: 'O Método Malach é um protocolo natural desenvolvido para quem vive sobrecarregado por ansiedade, depressão, estresse crônico ou mente hiperativa. Usamos exclusivamente a parte nobre de plantas medicinais, maturadas por quase 60 dias, para restaurar o equilíbrio do seu sistema nervoso sem o peso de remédios sintéticos.'
  },
  {
    q: 'O que exatamente chega na minha casa ao comprar o kit?',
    a: 'Você recebe a caixa do Método Malach com 4 sachês especiais (totalizando o ciclo de 30 dias), acompanhada do Guia Prático com o passo a passo de preparo diário e acesso ao canal de suporte para acompanhar cada etapa da sua evolução.'
  },
  {
    q: 'Será que funciona comigo se eu já tentei outros métodos?',
    a: 'Sim. A maioria das pessoas que chegam até nós já experimentou chás comuns, cápsulas de farmácia e calmantes que deixavam a mente lenta. O Método Malach age de forma diferente porque concentra apenas os princípios ativos mais puros da planta, sem aditivos químicos que sobrecarregam o organismo.'
  },
  {
    q: 'Como devo tomar na minha rotina?',
    a: 'O preparo é simples e leva menos de 5 minutos por dia. O protocolo é dividido em 4 etapas conscientes (Fundamento, Ritmo, Constância e Propósito) para acompanhar seu corpo progressivamente ao longo das 4 semanas.'
  },
  {
    q: 'Posso usar junto com meus medicamentos de uso contínuo?',
    a: 'Sim, o Método Malach é um apoio natural e você não deve interromper nenhum tratamento prescrito por conta própria. Recomendamos manter seu acompanhamento médico normal.'
  },
  {
    q: 'E se eu não sentir resultado? Qual é a garantia?',
    a: 'Confiamos plenamente na pureza do nosso lote. Se ao longo do protocolo de 30 dias você não sentir o alívio e a transformação no seu bem-estar, basta entrar em contato com nosso suporte para solicitar o reembolso conforme as diretrizes do nosso checkout seguro.'
  }
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#163a30" />
    <meta name="description" content="Método Malach — O protocolo vegetal de 30 dias para recuperar a calma, o sono profundo e a disposição." />
    <meta property="og:title" content="Método Malach — Recupere Sua Calma e Disposição" />
    <meta property="og:description" content="Protocolo natural da parte nobre da planta para quem convive com ansiedade, mente acelerada e estresse." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sofia+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,700&display=swap" rel="stylesheet" />
    <title>Método Malach — O Protocolo de 30 Dias para Sua Calma Natural</title>
  </head>
  <body class="overflow-x-hidden text-ink antialiased">
    
    <!-- AVISO SUPERIOR SUTIL (ESTILO RYZE) -->
    <div class="bg-forest-deep px-3 py-2 text-center text-[11px] sm:text-xs font-semibold text-cream/90 flex items-center justify-center gap-1.5">
      <svg class="w-3.5 h-3.5 text-gold shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/>
        <path d="m3.3 7 8.7 5 8.7-5"/>
        <path d="M12 22V12"/>
      </svg>
      <span>Lote artesanal limitado &bull; Envio com código de rastreio para todo o Brasil</span>
    </div>

    <!-- CABEÇALHO LIMPO E HUMANO -->
    <header class="border-b border-forest/10 bg-paper/95 backdrop-blur sticky top-0 z-40">
      <div class="container-page flex items-center justify-between py-3.5">
        <Logo class="text-forest scale-95" />
        <a 
          data-cta="header" 
          href={checkoutUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="focusable rounded-full bg-forest px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-cream transition hover:bg-forest-deep sm:text-sm"
        >
          Garantir Meu Kit
        </a>
      </div>
    </header>

    <main id="conteudo">

      <!-- HERO EDITORIAL (MOBILE: TÍTULO AO LADO DA IMAGEM EXATAMENTE COMO NO PRINT | DESKTOP: IMAGEM GRANDE À DIREITA) -->
      <section id="inicio" class="relative bg-paper pt-6 pb-12 sm:pt-10 sm:pb-16 lg:pt-12 lg:pb-20 border-b border-forest/10 overflow-hidden">
        <div class="container-page relative min-h-[auto] lg:min-h-[660px] xl:min-h-[700px] flex flex-col justify-center">
          
          <div class="relative z-20 reveal py-1 sm:py-2">
            
            <!-- 1. Topo: Eyebrow e Prova Social (Sempre no topo antes de tudo) -->
            <div class="max-w-xl lg:max-w-[68%] xl:max-w-[72%] mb-3 lg:mb-4">
              <p class="text-xs sm:text-sm font-extrabold uppercase tracking-widest text-coral mb-2">
                CALMA &bull; FOCO &bull; SONO PROFUNDO &bull; EQUILÍBRIO NATURAL
              </p>

              <div class="flex items-center gap-2">
                <div class="flex text-amber-500 text-xs sm:text-sm tracking-tight" aria-hidden="true">
                  ★★★★★
                </div>
                <span class="text-[11px] sm:text-xs font-semibold text-forest/80">
                  Avaliado com 5 estrelas por quem concluiu o protocolo
                </span>
              </div>
            </div>

            <!-- 2. VERSÃO MOBILE (< lg): Título na esquerda contornando a imagem na direita (IDÊNTICO AO SEU PRINT) -->
            <div class="relative lg:hidden mb-4">
              <!-- Imagem no Celular: Ancorada na direita com tamanho sob medida -->
              <div class="absolute right-[-10px] top-0 w-[58%] max-w-[242px] pointer-events-none z-10">
                <div class="relative w-full">
                  <div class="absolute inset-0 -m-3 rounded-full bg-sand/60 blur-xl -z-10"></div>
                  <Image 
                    src={heroKitReal} 
                    alt="Kit oficial do Método Malach com planta medicinal e as 4 caixas semanais" 
                    widths={[360, 500]} 
                    sizes="58vw" 
                    format="webp" 
                    quality={92} 
                    class="h-auto w-full object-contain drop-shadow-[0_16px_28px_rgba(22,58,48,0.18)]" 
                    loading="eager"
                  />
                </div>
              </div>

              <!-- Título no Celular: Ocupa a esquerda e altura emparelhada com a imagem -->
              <div class="relative z-20 w-[60%] pt-1">
                <h1 class="display text-[2.25rem] sm:text-[2.5rem] leading-[1.22] text-forest font-extrabold tracking-tighter">
                  Recuperando<br />
                  sua calma e<br />
                  <span class="text-coral">disposição</span><br />
                  <span class="text-coral">diária</span>.
                </h1>
              </div>
            </div>

            <!-- 2. VERSÃO DESKTOP (lg:): Imagem grande no canto direito e título avançando até a folhagem -->
            <div class="hidden lg:block">
              <!-- Imagem Desktop: Grande, imponente e ancorada à direita -->
              <div class="lg:absolute lg:right-[-2%] xl:right-[-1%] lg:bottom-[-8px] lg:w-[64%] xl:w-[60%] max-w-[880px] pointer-events-none z-0 flex justify-end">
                <div class="relative w-full">
                  <Image 
                    src={heroKitReal} 
                    alt="Kit oficial do Método Malach com planta medicinal e as 4 caixas semanais" 
                    widths={[700, 1000, 1500]} 
                    sizes="(min-width: 1024px) 62vw, 95vw" 
                    format="webp" 
                    quality={95} 
                    class="h-auto w-full object-contain drop-shadow-[0_26px_45px_rgba(22,58,48,0.2)]" 
                    loading="eager"
                  />
                </div>
              </div>

              <!-- H1 Desktop -->
              <div class="relative z-20 max-w-xl lg:max-w-[68%] xl:max-w-[72%]">
                <h1 class="display text-[clamp(2.5rem,4.8vw,4.4rem)] leading-[1.04] text-forest font-extrabold">
                  Recuperando sua calma e <span class="text-coral">disposição diária</span>.
                </h1>
              </div>
            </div>

            <!-- 3. Meio: Parágrafo (no mobile enxuto e direto; no desktop detalhado e editorial) -->
            <div class="relative z-20 mt-2 sm:mt-4 max-w-xl lg:max-w-[58%] xl:max-w-[61%]">
              <p class="text-sm sm:text-base lg:text-lg leading-relaxed text-muted">
                <span class="lg:hidden">O protocolo natural puro que silencia a mente agitada e devolve o sono profundo — sem remédios sintéticos e sem dependência.</span>
                <span class="hidden lg:inline">Para você que acorda cansado, vive com a mente acelerada e quer voltar a ter paz. O <strong>Método Malach</strong> é um protocolo natural puro de 30 dias feito a partir da parte nobre de plantas medicinais, silenciando a inquietação e devolvendo o seu sono — sem remédios sintéticos e sem dependência.</span>
              </p>
            </div>

            <!-- 4. Base: Benefícios e Botão (No mobile pílulas compactas estilo Ryze; no desktop lista completa) -->
            <div class="relative z-20 mt-3.5 sm:mt-5 max-w-lg lg:max-w-[50%] xl:max-w-[52%]">
              <!-- Mobile: Pills/Tags compactas horizontais (Estilo Ryze / AG1) -->
              <div class="flex flex-wrap items-center justify-center gap-2 lg:hidden text-xs font-semibold text-forest">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-forest/5 px-2.5 py-1 border border-forest/10">
                  <svg class="w-3.5 h-3.5 text-coral shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                  </svg>
                  Sono reparador
                </span>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-forest/5 px-2.5 py-1 border border-forest/10">
                  <svg class="w-3.5 h-3.5 text-coral shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                  </svg>
                  Calma sem sonolência
                </span>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-forest/5 px-2.5 py-1 border border-forest/10">
                  <svg class="w-3.5 h-3.5 text-coral shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                  </svg>
                  100% natural
                </span>
              </div>

              <!-- Desktop: Lista de Benefícios Diretos com Ícones Naturais -->
              <div class="hidden lg:block space-y-2.5 text-sm sm:text-base text-forest/90">
                <div class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 text-coral shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                  </svg>
                  <span>Mente calma e quieta durante o dia, sem sonolência</span>
                </div>
                <div class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 text-coral shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                  </svg>
                  <span>Sono reparador da primeira à última hora da noite</span>
                </div>
                <div class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 text-coral shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                  </svg>
                  <span>Disposição e paciência para viver presente com sua família</span>
                </div>
                <div class="flex items-center gap-2.5">
                  <svg class="w-4 h-4 text-coral shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                  </svg>
                  <span>100% natural, sem misturas industriais ou substâncias artificiais</span>
                </div>
              </div>

              <!-- CTA Principal do Hero -->
              <div class="mt-4 sm:mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
                <a 
                  data-cta="hero" 
                  href={checkoutUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="focusable inline-flex min-h-14 items-center justify-center rounded-full bg-coral px-8 py-3.5 text-center font-bold text-white shadow-warm transition hover:bg-[#c65536] hover:-translate-y-0.5 text-base sm:text-lg w-full sm:w-auto"
                >
                  Começar Meu Protocolo
                </a>
                <span class="text-xs text-muted text-center sm:text-left flex items-center justify-center sm:justify-start gap-1.5">
                  <svg class="w-4 h-4 text-coral shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    <path d="m9 12 2 2 4-4"/>
                  </svg>
                  <span>Garantia de 30 dias</span>
                </span>
              </div>
            </div>

          </div>

        </div>
      </section>

      <!-- BARRA DE CONFIANÇA (ESTILO MARCAS D2C / RYZE - TRAÇOS DELICADOS) -->
      <section class="bg-sand/40 border-b border-forest/10 py-7">
        <div class="container-page">
          <div class="grid grid-cols-2 gap-6 text-center sm:grid-cols-4 lg:grid-cols-4 items-start">
            
            <!-- 1. Origem 100% Natural -->
            <div class="flex flex-col items-center">
              <div class="h-10 w-10 flex items-center justify-center text-coral mb-1.5">
                <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 18c6-2 10-6 12-14-8 2-12 6-14 12 0 1 .5 2 2 2Z"/>
                  <path d="M6 18c-2 2-3 4-3 4"/>
                  <path d="M9 15l4-4"/>
                </svg>
              </div>
              <p class="font-bold text-forest text-sm sm:text-base tracking-tight">Origem 100% Natural</p>
              <p class="text-xs text-muted mt-0.5">Sem compostos químicos sintéticos</p>
            </div>

            <!-- 2. Parte Nobre da Planta -->
            <div class="flex flex-col items-center">
              <div class="h-10 w-10 flex items-center justify-center text-coral mb-1.5">
                <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22v-9"/>
                  <path d="M12 13c-2.5-1.5-4.5-1-6 1 0-3.5 2-6 6-6"/>
                  <path d="M12 9c2.5-1.5 4.5-1 6 1 0-3.5-2-6-6-6"/>
                  <circle cx="12" cy="4" r="2"/>
                </svg>
              </div>
              <p class="font-bold text-forest text-sm sm:text-base tracking-tight">Parte Nobre da Planta</p>
              <p class="text-xs text-muted mt-0.5">Apenas a porção com maior potência</p>
            </div>

            <!-- 3. Livre de Dependência -->
            <div class="flex flex-col items-center">
              <div class="h-10 w-10 flex items-center justify-center text-coral mb-1.5">
                <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <path d="m9 12 2 2 4-4"/>
                </svg>
              </div>
              <p class="font-bold text-forest text-sm sm:text-base tracking-tight">Livre de Dependência</p>
              <p class="text-xs text-muted mt-0.5">Uso seguro e sem sedação diurna</p>
            </div>

            <!-- 4. Garantia de 30 Dias -->
            <div class="flex flex-col items-center">
              <div class="h-10 w-10 flex items-center justify-center text-coral mb-1.5">
                <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="9" r="6"/>
                  <path d="m8.5 14.5-1.5 6.5 5-2.5 5 2.5-1.5-6.5"/>
                  <path d="m10 9 1.5 1.5L14 8"/>
                </svg>
              </div>
              <p class="font-bold text-forest text-sm sm:text-base tracking-tight">Garantia de 30 Dias</p>
              <p class="text-xs text-muted mt-0.5">Satisfação ou seu dinheiro de volta</p>
            </div>

          </div>
        </div>
      </section>

      <!-- DOBRA DE VÍDEOS VERTICAIS REAIS (ESTILO RYZE REELS / HISTÓRIAS DE CLIENTES) -->
      <section id="depoimentos-videos" class="py-10 sm:py-12 lg:py-14 bg-paper border-b border-forest/10">
        <div class="container-page">
          <div class="reveal max-w-2xl text-center mx-auto">
            <p class="text-xs sm:text-sm font-extrabold uppercase tracking-widest text-coral mb-2">
              HISTÓRIAS REAIS &bull; SEM FILTRO
            </p>
            <h2 class="display text-[2.2rem] sm:text-[clamp(2.4rem,4.5vw,3.4rem)] leading-[1.08] text-forest font-extrabold tracking-tight mt-2">
              Veja como pessoas reais estão <span class="text-coral">se sentindo</span>.
            </h2>
            <p class="mt-2.5 text-base sm:text-lg leading-relaxed text-muted">
              Relatos espontâneos de quem convivia com o cansaço diário e a mente agitada — e recuperou sua paz com o <strong>Método Malach</strong>.
            </p>
          </div>

          <!-- Carrossel de Vídeos Verticais Autênticos -->
          <div class="mt-6 sm:mt-8">
